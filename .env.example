APP_ENV=development
# Replace these development placeholders; use URL-safe hexadecimal passwords.
POSTGRES_PASSWORD=replace-admin-password
POSTGRES_APP_PASSWORD=replace-app-password
POSTGRES_MIGRATION_PASSWORD=replace-migration-password
DATABASE_URL=postgres://route_mind_app:${POSTGRES_APP_PASSWORD}@127.0.0.1:55432/route_mind?sslmode=disable
MIGRATION_DATABASE_URL=postgres://route_mind_migrator:${POSTGRES_MIGRATION_PASSWORD}@127.0.0.1:55432/route_mind?sslmode=disable
DATABASE_SCHEMA=public
GATEWAY_API_KEY=replace-with-a-random-api-key
MOCK_API_KEY=local-mock-only
# Optional Redis profile; only host-loopback development permits plaintext.
# Production: rediss://ACL_USER:URL_ENCODED_PASSWORD@VERIFIED_TLS_HOST:6379/0
REDIS_URL=redis://127.0.0.1:56379/0
# Only needed when explicitly switching to real providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
